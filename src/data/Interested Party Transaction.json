            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "Previously effective UAE Law No. 2 (2015) ",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
