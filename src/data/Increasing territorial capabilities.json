  "content": [
    {
      "text": "Expanding territorial scope of operations for companies based in Dubai’s free zones",
      "formatted_text": [
        {
          "text": "Expanding territorial scope of operations for companies based in Dubai’s free zones",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
