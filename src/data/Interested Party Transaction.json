    {
      "text": "Conflict of interest transactions",
      "formatted_text": [
        {
          "text": "Conflict of interest transactions",
          "formatting": {
            "bold": true,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
