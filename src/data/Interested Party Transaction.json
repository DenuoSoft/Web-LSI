            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "Given that the ",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
