            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "As a result, only the rules governing transactions involving conflict of interest applied to limited liability companies.",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
