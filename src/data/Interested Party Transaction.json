            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "[6]",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": true
          },
          "hyperlink": null,
          "is_footnote_reference": true,
          "footnote_id": "6"
        },
        {
          "text": " ",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "In this regard, the UAE Cabinet may issue a decision clarifying which specific provisions of the Law apply to limited liability companies and establishing rules for the application of related-party transactions to limited liability companies.",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": " ",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "[7]",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": true
          },
          "hyperlink": null,
          "is_footnote_reference": true,
          "footnote_id": "7"
