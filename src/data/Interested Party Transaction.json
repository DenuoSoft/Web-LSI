            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "As of now, no such decision has been made.",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
