            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": " was amended in 2021 and the Decision was not formally repealed, there is currently uncertainty as to whether the Decision applies to the Law.",
          "formatting": {
