    {
      "text": "Employees insurance",
      "formatted_text": [
        {
          "text": "Employees insurance",
          "formatting": {
            "bold": true,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
