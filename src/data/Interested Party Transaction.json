            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": " also contained a similar provision in Article 104 regarding the application of the rules governing joint-stock companies to limited liability companies mutatis mutandis.",
          "formatting": {
