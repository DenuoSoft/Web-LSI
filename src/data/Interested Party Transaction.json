          },
          "hyperlink": null
        },
        {
          "text": " ",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
          "text": "[5]",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": true
          },
          "hyperlink": null,
          "is_footnote_reference": true,
          "footnote_id": "5"
        },
        {
          "text": "In addition, the Law establishes that its provisions concerning joint-stock companies apply to limited liability companies, unless the application of any such provisions conflicts with the legal nature of the limited liability company.",
          "formatting": {
            "bold": false,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
            "superscript": false
          },
          "hyperlink": null
        },
        {
