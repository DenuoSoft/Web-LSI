    {
      "text": "Laws application in UAE free zones",
      "formatted_text": [
        {
          "text": "Laws application in UAE free zones",
          "formatting": {
            "bold": true,
            "italic": false,
            "underline": false,
            "strike": false,
            "font_name": null,
            "font_size": null,
            "color": null,
